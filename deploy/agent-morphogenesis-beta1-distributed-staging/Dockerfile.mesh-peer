FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NODE_ENV=production

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages

RUN pnpm install --frozen-lockfile \
  && pnpm -r run build \
  && pnpm store prune

COPY examples/mesh-multiprocess ./examples/mesh-multiprocess

USER node
EXPOSE 43101

CMD ["node", "examples/mesh-multiprocess/staging-entrypoint.mjs"]
