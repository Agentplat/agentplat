{
  "name": "agentplat",
  "version": "0.3.0-alpha.5",
  "private": true,
  "description": "Open-core runtime primitives for building agentic platforms.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "type-check": "pnpm -r --workspace-concurrency=4 run type-check && pnpm run type-check:public",
    "type-check:public": "tsc -p tsconfig.type-tests.json",
    "test:unit": "node --test tests/*.test.mjs",
    "test:adapters": "pnpm --filter @agentplat/sessions-redis test && pnpm --filter @agentplat/audit-postgres test && pnpm --filter @agentplat/mesh-postgres test && pnpm --filter @agentplat/rooms-api test && pnpm --filter @agentplat/rooms-postgres test",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:adapters",
    "example:basic": "pnpm run build && node examples/basic-runtime.mjs",
    "example:quick": "pnpm run build && node examples/quick-run.mjs",
    "example:sessions": "pnpm run build && node examples/multi-agent-session.mjs",
    "example:mesh-multiprocess": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-http --filter @agentplat/mesh-postgres build && node examples/mesh-multiprocess/demo.mjs",
    "benchmark:mesh-adapters": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-http --filter @agentplat/mesh-postgres build && node scripts/mesh-adapters-benchmark.mjs",
    "example:rooms": "pnpm --dir examples/rooms-api start",
    "audit:public": "node scripts/audit-public.mjs",
    "audit:public:release": "node scripts/audit-public.mjs --require-terminology-denylist",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:inference-control-scenarios": "node scripts/inference-control-scenarios.mjs --check",
    "verify:trust-scenarios": "node scripts/trust-scenarios.mjs --check",
    "verify:pack": "node scripts/pack-smoke.mjs",
    "verify:registry-consumer": "node scripts/verify-registry-consumer.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:publish": "pnpm run audit:public:release && pnpm run check && node scripts/publish-packages.mjs",
    "release:publish:next": "NPM_DIST_TAG=next pnpm run release:publish",
    "check": "pnpm run audit:public && pnpm run clean && pnpm run build && pnpm run audit:public && pnpm run type-check && pnpm run test:unit && pnpm run test:adapters && pnpm run verify:inference-control-scenarios && pnpm run verify:trust-scenarios && pnpm run verify:release && pnpm run verify:pack"
  },
  "devDependencies": {
    "@agentplat/audit": "workspace:*",
    "@agentplat/audit-postgres": "workspace:*",
    "@agentplat/auth": "workspace:*",
    "@agentplat/core": "workspace:*",
    "@agentplat/events": "workspace:*",
    "@agentplat/framework": "workspace:*",
    "@agentplat/inference-control": "workspace:*",
    "@agentplat/mcp": "workspace:*",
    "@agentplat/memory": "workspace:*",
    "@agentplat/mesh": "workspace:*",
    "@agentplat/mesh-crypto": "workspace:*",
    "@agentplat/mesh-http": "workspace:*",
    "@agentplat/mesh-postgres": "workspace:*",
    "@agentplat/mesh-protocol": "workspace:*",
    "@agentplat/mesh-sim": "workspace:*",
    "@agentplat/model": "workspace:*",
    "@agentplat/model-openai-compatible": "workspace:*",
    "@agentplat/provider-openai": "workspace:*",
    "@agentplat/postgres": "workspace:*",
    "@agentplat/rooms": "workspace:*",
    "@agentplat/rooms-api": "workspace:*",
    "@agentplat/rooms-mesh": "workspace:*",
    "@agentplat/rooms-postgres": "workspace:*",
    "@agentplat/runtime": "workspace:*",
    "@agentplat/runtime-mock": "workspace:*",
    "@agentplat/sessions": "workspace:*",
    "@agentplat/sessions-redis": "workspace:*",
    "@agentplat/streaming": "workspace:*",
    "@agentplat/tools": "workspace:*",
    "@agentplat/workflows": "workspace:*",
    "prettier": "^3.1.0",
    "semver": "^7.7.2",
    "typescript": "^5.3.0"
  }
}
