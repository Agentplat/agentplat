{
  "name": "agentplat",
  "version": "0.3.0-beta.3",
  "private": true,
  "description": "Open-core runtime primitives for building agentic platforms.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.4.0"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "type-check": "pnpm -r --workspace-concurrency=4 run type-check && pnpm run type-check:public",
    "type-check:public": "tsc -p tsconfig.type-tests.json",
    "test:unit": "node --test tests/*.test.mjs",
    "test:adapters": "pnpm --filter @agentplat/sessions-redis test && pnpm --filter @agentplat/audit-postgres test && pnpm --filter @agentplat/mesh-postgres test && pnpm --filter @agentplat/collective-control-postgres test && pnpm --filter @agentplat/collective-membership test && pnpm --filter @agentplat/collective-membership-postgres test && pnpm --filter @agentplat/collective-quorum test && pnpm --filter @agentplat/collective-quorum-postgres test && pnpm --filter @agentplat/collective-sync test && pnpm --filter @agentplat/collective-sync-postgres test && pnpm --filter @agentplat/planning-artifacts test && pnpm --filter @agentplat/planning-artifacts-postgres test && pnpm --filter @agentplat/rooms-api test && pnpm --filter @agentplat/rooms-postgres test && pnpm --filter @agentplat/mesh-sim-local test && pnpm --filter @agentplat/mesh-sim-postgres test",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:adapters",
    "example:basic": "pnpm run build && node examples/basic-runtime.mjs",
    "example:quick": "pnpm run build && node examples/quick-run.mjs",
    "example:sessions": "pnpm run build && node examples/multi-agent-session.mjs",
    "example:collective": "pnpm run build && node examples/collective-runtime.mjs",
    "example:portable-agent": "pnpm --filter @agentplat/runtime build && node examples/portable-agent-adapter.mjs",
    "example:role-alignment": "pnpm --filter @agentplat/inference-control... build && node examples/continuous-role-alignment.mjs",
    "example:role-realignment": "pnpm --filter @agentplat/inference-control build && node examples/adaptive-role-realignment.mjs",
    "example:role-refinement": "pnpm --filter @agentplat/inference-control build && node examples/certified-role-refinement.mjs",
    "example:mesh-multiprocess": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-http --filter @agentplat/mesh-postgres build && node examples/mesh-multiprocess/demo.mjs",
    "example:collective-quorum-multiprocess": "pnpm --filter @agentplat/collective-quorum --filter @agentplat/collective-quorum-postgres build && node examples/collective-quorum-multiprocess/demo.mjs",
    "example:collective-membership-multiprocess": "pnpm --filter @agentplat/collective-membership --filter @agentplat/collective-membership-postgres build && node examples/collective-membership-multiprocess/demo.mjs",
    "example:collective-sync-multiprocess": "pnpm --filter @agentplat/collective-sync --filter @agentplat/collective-sync-postgres build && node examples/collective-sync-multiprocess/demo.mjs",
    "example:planning-artifacts-multiprocess": "pnpm --filter @agentplat/planning-artifacts... --filter @agentplat/planning-artifacts-postgres... build && node examples/planning-artifacts-multiprocess/demo.mjs",
    "example:execution-checkpoint-handoff-multiprocess": "pnpm --filter @agentplat/collective-runtime... --filter @agentplat/collective-sync-postgres... build && node examples/execution-checkpoint-handoff-multiprocess/demo.mjs",
    "example:byzantine-agreement-multiprocess": "pnpm --filter @agentplat/collective-quorum-postgres... build && node examples/byzantine-agreement-multiprocess/demo.mjs",
    "benchmark:mesh-adapters": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-http --filter @agentplat/mesh-postgres build && node scripts/mesh-adapters-benchmark.mjs",
    "example:rooms": "pnpm --dir examples/rooms-api start",
    "audit:public": "node scripts/audit-public.mjs",
    "audit:public:release": "node scripts/audit-public.mjs --require-terminology-denylist",
    "audit:dependencies:production": "node scripts/production-dependency-audit.mjs --mode run --allowlist config/production-dependency-audit-allowlist.json --output-directory dependency-audit",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:inference-control-scenarios": "node scripts/inference-control-scenarios.mjs --check",
    "verify:trust-scenarios": "node scripts/trust-scenarios.mjs --check",
    "fixtures:mesh-protocol:write": "pnpm --filter @agentplat/mesh-protocol build && node scripts/mesh-protocol-fixtures.mjs --write",
    "verify:mesh-protocol-fixtures": "pnpm --filter @agentplat/mesh-protocol build && node scripts/mesh-protocol-fixtures.mjs",
    "fixtures:mesh-persistence:write": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-sim build && node scripts/mesh-persistence-fixtures.mjs --write",
    "verify:mesh-persistence-fixtures": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-sim build && node scripts/mesh-persistence-fixtures.mjs",
    "verify:mesh-compatibility": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol build && node scripts/mesh-beta1-compatibility.mjs",
    "verify:mesh-postgres-faults": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-postgres build && node scripts/mesh-beta1-postgres-fault-matrix.mjs",
    "verify:mesh-soak": "pnpm --filter @agentplat/mesh --filter @agentplat/mesh-crypto --filter @agentplat/mesh-protocol --filter @agentplat/mesh-http --filter @agentplat/mesh-postgres build && node scripts/mesh-beta1-soak.mjs",
    "preflight:collective-evaluation": "pnpm --filter @agentplat/collective-control --filter @agentplat/mesh-sim build && node scripts/collective-beta2-evaluation.mjs --mode preflight --output-directory /private/tmp/agentplat-beta2-evaluation-preflight",
    "evidence:collective-evaluation": "pnpm --filter @agentplat/collective-control --filter @agentplat/mesh-sim build && node scripts/collective-beta2-evaluation.mjs --mode normative",
    "verify:collective-evaluation": "pnpm --filter @agentplat/collective-control --filter @agentplat/mesh-sim build && node scripts/collective-beta2-evaluation.mjs --mode check",
    "verify:collective-evaluation-v2-fixture": "pnpm --filter @agentplat/collective-planning build && node scripts/collective-planning-evaluation-fixture.mjs",
    "verify:collective-statistical-campaign:contract-smoke": "node scripts/collective-beta3-statistical-campaign.mjs",
    "verify:collective-normative-control-plane": "node scripts/pack-consumers/collective-normative-control-plane.mjs",
    "evidence:collective-postgres": "pnpm --filter @agentplat/collective-control-postgres --filter @agentplat/mesh-conformance build && node scripts/collective-beta2-postgres-conformance.mjs",
    "verify:collective-postgres": "pnpm --filter @agentplat/collective-control-postgres --filter @agentplat/mesh-conformance build && node scripts/collective-beta2-postgres-conformance.mjs --mode check",
    "evidence:collective-compatibility": "node scripts/collective-beta2-compatibility.mjs",
    "verify:collective-compatibility": "node scripts/collective-beta2-compatibility.mjs --mode check",
    "verify:alpha5-compatibility": "node scripts/verify-alpha5-compatibility.mjs",
    "verify:pack": "node scripts/pack-smoke.mjs",
    "verify:collective-planning-closed-loop": "pnpm --filter @agentplat/mesh-sim build && node scripts/pack-consumers/collective-planning-closed-loop.mjs",
    "verify:collective-closed-loop-resilience": "pnpm --filter @agentplat/mesh-sim build && node scripts/pack-consumers/collective-planning-closed-loop-resilience.mjs",
    "verify:registry-consumer": "node scripts/verify-registry-consumer.mjs",
    "verify:packed-postgres-consumer": "pnpm --filter @agentplat/collective-control-postgres... --filter @agentplat/mesh-conformance... build && node scripts/verify-packed-postgres-consumer.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:publish": "pnpm run audit:public:release && pnpm run check && node scripts/publish-packages.mjs",
    "release:publish:next": "NPM_DIST_TAG=next pnpm run release:publish",
    "check": "pnpm run audit:public && pnpm run clean && pnpm run build && pnpm run audit:public && pnpm run type-check && pnpm run test:unit && pnpm run test:adapters && pnpm run verify:mesh-protocol-fixtures && pnpm run verify:mesh-persistence-fixtures && pnpm run verify:mesh-compatibility && pnpm run verify:alpha5-compatibility && pnpm run verify:collective-evaluation && pnpm run verify:collective-evaluation-v2-fixture && pnpm run verify:collective-statistical-campaign:contract-smoke && pnpm run verify:collective-normative-control-plane && pnpm run verify:collective-postgres && pnpm run verify:collective-compatibility && pnpm run verify:inference-control-scenarios && pnpm run verify:trust-scenarios && pnpm run verify:release && pnpm run verify:collective-planning-closed-loop && pnpm run verify:collective-closed-loop-resilience && pnpm run verify:pack"
  },
  "devDependencies": {
    "@agentplat/audit": "workspace:*",
    "@agentplat/audit-postgres": "workspace:*",
    "@agentplat/auth": "workspace:*",
    "@agentplat/collective-control": "workspace:*",
    "@agentplat/collective-control-postgres": "workspace:*",
    "@agentplat/collective-membership": "workspace:*",
    "@agentplat/collective-membership-postgres": "workspace:*",
    "@agentplat/collective-planning": "workspace:*",
    "@agentplat/collective-quorum": "workspace:*",
    "@agentplat/collective-quorum-postgres": "workspace:*",
    "@agentplat/collective-runtime": "workspace:*",
    "@agentplat/collective-sync": "workspace:*",
    "@agentplat/collective-sync-postgres": "workspace:*",
    "@agentplat/core": "workspace:*",
    "@agentplat/events": "workspace:*",
    "@agentplat/framework": "workspace:*",
    "@agentplat/inference-control": "workspace:*",
    "@agentplat/mcp": "workspace:*",
    "@agentplat/memory": "workspace:*",
    "@agentplat/mesh": "workspace:*",
    "@agentplat/mesh-conformance": "workspace:*",
    "@agentplat/mesh-crypto": "workspace:*",
    "@agentplat/mesh-http": "workspace:*",
    "@agentplat/mesh-postgres": "workspace:*",
    "@agentplat/mesh-protocol": "workspace:*",
    "@agentplat/mesh-sim": "workspace:*",
    "@agentplat/mesh-sim-local": "workspace:*",
    "@agentplat/mesh-sim-postgres": "workspace:*",
    "@agentplat/model": "workspace:*",
    "@agentplat/model-openai-compatible": "workspace:*",
    "@agentplat/planning-artifacts": "workspace:*",
    "@agentplat/planning-artifacts-postgres": "workspace:*",
    "@agentplat/provider-openai": "workspace:*",
    "@agentplat/postgres": "workspace:*",
    "@agentplat/rooms": "workspace:*",
    "@agentplat/rooms-api": "workspace:*",
    "@agentplat/rooms-mesh": "workspace:*",
    "@agentplat/rooms-postgres": "workspace:*",
    "@agentplat/runtime": "workspace:*",
    "@agentplat/runtime-mock": "workspace:*",
    "@agentplat/sessions": "workspace:*",
    "@agentplat/sessions-redis": "workspace:*",
    "@agentplat/streaming": "workspace:*",
    "@agentplat/tools": "workspace:*",
    "@agentplat/trust": "workspace:*",
    "@agentplat/workflows": "workspace:*",
    "prettier": "^3.1.0",
    "pg": "^8.13.1",
    "semver": "^7.7.2",
    "typescript": "^5.3.0"
  }
}
