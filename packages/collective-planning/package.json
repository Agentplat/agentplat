{
  "name": "@agentplat/collective-planning",
  "version": "0.3.0-beta.4",
  "description": "Portable contracts and deterministic primitives for distributed mission planning.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./development-evidence": {
      "types": "./dist/development-evidence.d.ts",
      "import": "./dist/development-evidence.js"
    },
    "./distributed-decomposition": {
      "types": "./dist/distributed-decomposition.d.ts",
      "import": "./dist/distributed-decomposition.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation.d.ts",
      "import": "./dist/evaluation.js"
    },
    "./mesh": {
      "types": "./dist/mesh.d.ts",
      "import": "./dist/mesh.js"
    },
    "./mission-continuity": {
      "types": "./dist/mission-continuity.d.ts",
      "import": "./dist/mission-continuity.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/collective-control": "workspace:^",
    "@agentplat/core": "workspace:^",
    "@agentplat/mesh": "workspace:^",
    "@agentplat/mesh-protocol": "workspace:^"
  },
  "engines": {
    "node": ">=20.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/collective-planning"
  }
}
