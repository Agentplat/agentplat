{
  "name": "@agentplat/collective-host-postgres",
  "version": "0.3.0-beta.4",
  "description": "PostgreSQL durability for Agentplat collective host runtimes and protocol artifacts.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/collective-control": "workspace:^",
    "@agentplat/collective-host": "workspace:^",
    "@agentplat/interop": "workspace:^",
    "@agentplat/inference-control": "workspace:^",
    "@agentplat/postgres": "workspace:^",
    "@agentplat/trust": "workspace:^",
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/collective-host-postgres"
  }
}
