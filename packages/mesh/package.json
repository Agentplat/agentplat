{
  "name": "@agentplat/mesh",
  "version": "0.3.0-alpha.2",
  "description": "Provider-neutral peer state and effect contracts for AgentPlat Mesh applications.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loopback": {
      "types": "./dist/loopback.d.ts",
      "import": "./dist/loopback.js"
    },
    "./coordination": {
      "types": "./dist/coordination.d.ts",
      "import": "./dist/coordination.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/mesh-crypto": "workspace:^",
    "@agentplat/mesh-protocol": "workspace:^"
  },
  "engines": {
    "node": ">=20.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/mesh"
  }
}
