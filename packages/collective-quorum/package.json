{
  "name": "@agentplat/collective-quorum",
  "version": "0.3.0-beta.3",
  "description": "Signed peer quorum protocols and Agentplat collective runtime adapters.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agreement": {
      "types": "./dist/agreement.d.ts",
      "import": "./dist/agreement.js"
    },
    "./sparse-agreement": {
      "types": "./dist/sparse-agreement.d.ts",
      "import": "./dist/sparse-agreement.js"
    },
    "./sparse-agreement-runtime": {
      "types": "./dist/sparse-agreement-runtime.d.ts",
      "import": "./dist/sparse-agreement-runtime.js"
    },
    "./role-realignment": {
      "types": "./dist/role-realignment.d.ts",
      "import": "./dist/role-realignment.js"
    },
    "./trust-consensus": {
      "types": "./dist/trust-consensus.d.ts",
      "import": "./dist/trust-consensus.js"
    },
    "./collective-decision": {
      "types": "./dist/collective-decision.d.ts",
      "import": "./dist/collective-decision.js"
    },
    "./mission-context-fusion": {
      "types": "./dist/mission-context-fusion.d.ts",
      "import": "./dist/mission-context-fusion.js"
    },
    "./collusion-aware-context": {
      "types": "./dist/collusion-aware-context.d.ts",
      "import": "./dist/collusion-aware-context.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./partial-view-agreement": {
      "types": "./dist/partial-view-agreement.d.ts",
      "import": "./dist/partial-view-agreement.js"
    },
    "./equivocation-response": {
      "types": "./dist/equivocation-response.d.ts",
      "import": "./dist/equivocation-response.js"
    },
    "./webcrypto-ports": {
      "types": "./dist/webcrypto-ports.d.ts",
      "import": "./dist/webcrypto-ports.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/collective-control": "workspace:^",
    "@agentplat/collective-planning": "workspace:^",
    "@agentplat/collective-runtime": "workspace:^",
    "@agentplat/inference-control": "workspace:^",
    "@agentplat/mesh": "workspace:^",
    "@agentplat/mesh-crypto": "workspace:^",
    "@agentplat/mesh-protocol": "workspace:^",
    "@agentplat/trust": "workspace:^"
  },
  "engines": {
    "node": ">=20.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/collective-quorum"
  }
}
