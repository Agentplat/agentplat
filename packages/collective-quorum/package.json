{
  "name": "@agentplat/collective-quorum",
  "version": "0.3.0-beta.3",
  "description": "Signed peer quorum protocols and Agentplat collective runtime adapters.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agreement": {
      "types": "./dist/agreement.d.ts",
      "import": "./dist/agreement.js"
    },
    "./role-realignment": {
      "types": "./dist/role-realignment.d.ts",
      "import": "./dist/role-realignment.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/collective-control": "workspace:^",
    "@agentplat/collective-runtime": "workspace:^",
    "@agentplat/inference-control": "workspace:^",
    "@agentplat/mesh": "workspace:^",
    "@agentplat/mesh-crypto": "workspace:^",
    "@agentplat/mesh-protocol": "workspace:^",
    "@agentplat/trust": "workspace:^"
  },
  "engines": {
    "node": ">=20.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/collective-quorum"
  }
}
