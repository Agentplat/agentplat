{
  "name": "@agentplat/workflows-rooms",
  "version": "0.3.0-beta.7",
  "description": "Agent Room approval gates for AgentPlat governed workflows.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./morphogenesis": {
      "types": "./dist/morphogenesis.d.ts",
      "import": "./dist/morphogenesis.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/autonomy": "workspace:^",
    "@agentplat/collective-runtime": "workspace:^",
    "@agentplat/core": "workspace:^",
    "@agentplat/rooms": "workspace:^",
    "@agentplat/workflows": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/workflows-rooms"
  }
}
