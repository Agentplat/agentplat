{
  "name": "@agentplat/collective-membership",
  "version": "0.3.0-beta.3",
  "description": "Certified dynamic peer membership and overlapping key rotation for Agentplat collectives.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-lineage": {
      "types": "./dist/agent-lineage.d.ts",
      "import": "./dist/agent-lineage.js"
    },
    "./agent-factory": {
      "types": "./dist/reference-agent-factory.d.ts",
      "import": "./dist/reference-agent-factory.js"
    },
    "./governed-agent-lifecycle": {
      "types": "./dist/governed-agent-lifecycle.d.ts",
      "import": "./dist/governed-agent-lifecycle.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/collective-quorum": "workspace:^",
    "@agentplat/mesh-crypto": "workspace:^",
    "@agentplat/mesh-protocol": "workspace:^"
  },
  "engines": {
    "node": ">=20.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/collective-membership"
  }
}
