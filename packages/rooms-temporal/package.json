{
  "name": "@agentplat/rooms-temporal",
  "version": "0.3.0-beta.5",
  "description": "Optional Temporal adapter for durable AgentPlat Agent Room coordination.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:real": "pnpm run build && node tests/temporal-real.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/rooms": "workspace:^",
    "@temporalio/workflow": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "source-map": "^0.8.0"
  },
  "devDependencies": {
    "@temporalio/client": "^1.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/rooms-temporal"
  }
}
