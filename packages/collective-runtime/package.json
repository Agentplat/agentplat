{
  "name": "@agentplat/collective-runtime",
  "version": "0.3.0-beta.3",
  "description": "High-level provider-neutral runtime for capability-based AgentPlat collectives.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./peer": {
      "types": "./dist/peer.d.ts",
      "import": "./dist/peer.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./checkpoints": {
      "types": "./dist/checkpoints.d.ts",
      "import": "./dist/checkpoints.js"
    },
    "./capability-state": {
      "types": "./dist/capability-state.d.ts",
      "import": "./dist/capability-state.js"
    },
    "./strategy-adaptation": {
      "types": "./dist/strategy-adaptation.d.ts",
      "import": "./dist/strategy-adaptation.js"
    },
    "./strategy-evidence-exchange": {
      "types": "./dist/strategy-evidence-exchange.d.ts",
      "import": "./dist/strategy-evidence-exchange.js"
    },
    "./strategy-convergence": {
      "types": "./dist/strategy-convergence.d.ts",
      "import": "./dist/strategy-convergence.js"
    },
    "./team-formation": {
      "types": "./dist/team-formation.d.ts",
      "import": "./dist/team-formation.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentplat/collective-control": "workspace:^",
    "@agentplat/collective-planning": "workspace:^",
    "@agentplat/core": "workspace:^",
    "@agentplat/mesh": "workspace:^",
    "@agentplat/mesh-crypto": "workspace:^",
    "@agentplat/mesh-protocol": "workspace:^",
    "@agentplat/runtime": "workspace:^"
  },
  "engines": {
    "node": ">=20.19.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentplat/agentplat.git",
    "directory": "packages/collective-runtime"
  }
}
