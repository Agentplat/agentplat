  "authorityPolicy": {
    "personApprovalRequired": false,
    "authorizedAgentMayDecide": true,
    "authorizedPersonMayDecide": true,
    "collectiveCertificateMayDecide": true,
    "selfApprovalPermitted": false,
    "decisionMandateRequired": true
  },
  "evidenceBoundary": {
    "sourceCapability": "implemented",
    "conformance": "pending-campaign",
    "experimentalEvidence": "not-collected",
    "operationalReadiness": "not-established",
    "productionClaimPermitted": false,
    "securityCertificationClaimPermitted": false
  },
  "requiredArtifacts": [
    "source-lock.json",
    "campaign-registration.json",
    "scenario-manifest.json",
    "environment-manifest.json",
    "scenario-receipts.jsonl",
    "metrics.jsonl",
    "evidence-bundle.json",
    "operational-validation-report.md"
  ],
  "requiredSourceBinding": "exact-clean-commit",
  "scenarioManifest": "config/agent-morphogenesis-beta1-scenarios-v1.json",
  "excludedCapabilities": [
    "profile-synthesis",
    "recursive-agent-creation",
    "team-split-merge-federation"
